<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- vab's base manifest (platforms/android in vab) plus network access, which
     sync and login need; OpenGL ES 3.1, which sokol asks for; and a
     theme with the status bar plus adjustResize, so the on-screen keyboard
     shrinks the window instead of covering the field being typed in (Android
     doesn't resize a fullscreen window). uiMode in configChanges keeps the
     activity when the system switches between light and dark; the app
     follows it (VActivity.onConfigurationChanged).

     With an override manifest vab changes nothing in it, and leaves its Java
     activity in vab's own io.v.android package, so the final package id,
     version and SDK levels are written here, and the activity is named by its
     full class name. Keep them in step with `make android`. -->
<manifest xmlns:tools="http://schemas.android.com/tools"
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:versionCode="1"
	android:versionName="@string/v_app_name"
	android:installLocation="auto"
	package="com.jnyman.weight"
>

	<uses-sdk android:minSdkVersion="23" android:targetSdkVersion="34" />
	<uses-feature android:glEsVersion="0x00030001" android:required="true" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<application
		android:debuggable="false"
		android:hasCode="true"
		android:label="@string/v_app_name"
		android:theme="@android:style/Theme.Material.Light.NoActionBar"
		android:icon="@mipmap/icon"
		tools:replace="android:icon,android:theme,android:allowBackup,label"
	>

		<activity android:name="io.v.android.VActivity"
			android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
			android:launchMode="singleTask"
			android:windowSoftInputMode="adjustResize"
			android:exported="true"
		>
			<meta-data android:name="android.app.lib_name" android:value="@string/v_lib_name"/>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>
	</application>
</manifest>
