<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 and up: an adaptive icon, which the launcher crops to its own
     shape. Older versions use res/mipmap/icon.png, which vab copies from
     src/web/images/weight.png (the Makefile's icon option). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
	<background android:drawable="@drawable/icon_background"/>
	<foreground android:drawable="@drawable/icon_foreground"/>
</adaptive-icon>
